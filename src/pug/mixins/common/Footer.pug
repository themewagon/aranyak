mixin Footer 

  footer(style=`background-image: url('${CWD}assets/img/illustrations/BOTTOM.png')` class="Footer")
    .pb-x1.px-3.px-lg-0 
      .container 
        .row.align-items-end.g-4.g-sm-6
          .col-6.col-md-4
            .mb-6.mb-md-8
              a(href=`${CWD}`).cursor-pointer
                img(src=`${CWD}assets/img/logos/Footer_logo.png`, alt="").img-fluid
            div
              .mb-2 
                a(href="#").links.
                  home
              .mb-2 
                a(href="#about").links.
                  about
              .mb-2 
                a(href="#products").links.
                  catalog
              .mb-2 
                a(href="#review").links.
                  review
                
              a(href="#support").links.
                support

          .col-6.col-md-4
            .mb-3.mb-md-5 
              h3(style="color: #FFF0D3;").fs-9.fs-md-8.fw-bold.mb-0 User Account
            div
              .mb-2 
                a(href="#!").links.
                  sign up
              .mb-2 
                a(href="#!").links.
                  log in 
              .mb-2 
                a(href="#!").links.
                  edit profile
              .mb-2 
                a(href="#!").links.
                  history
                
              a(href="#!").links.
                refund

          .col-12.col-md-4
            .row.g-4.g-sm-6.g-md-0
              .col-6.col-md-12.mb-md-7
                h3(style="color: #FFF0D3;").fs-9.fs-md-8.fw-bold.mb-3 Follow Us At
                .d-flex.align-items-center 
                  a(href="#!").social-icon.me-2
                    span.uil.uil-facebook.fs-8
                  a(href="#!").social-icon.me-2
                    span.uil.uil-linkedin.fs-8
                  a(href="#!").social-icon.me-2
                    span.uil.uil-youtube.fs-8
                  a(href="#!").social-icon
                    span.uil.uil-twitter.fs-8
              .col-6.col-md-12 
                .mb-3
                  p(style="color: #FFF0D3;").fs-9.fs-md-8.fw-bold.lh-nomal.mb-0    Contact 
                .fs-10.fs-md-9
                  p.mb-0.text-white.opacity-70  Obito Uchiha
                  p.mb-0.text-white.opacity-70  Konoha, Leaf Village

    .bg-success.py-2.py-md-3.position-relative.terms-condition
      .overley-background
      .px-4.px-md-5.py-12.text-div
        .row.text-center.align-items-center 
          .col-12.col-lg-6.text-lg-start
            p.text-white.opacity-70.fs-10.fs-md-9.fs-xl-8.copyWrite.mb-lg-0 
              | &copy; 2024 Copyright, All right Reserved, Made by 
              a(href="https://themewagon.com").link-info.opacity-100.text-nowrap ❤️ ThemeWagon
          .col-12.col-lg-6.text-xl-end
            a(href="#!" title="F.A.Q").links  F.A.Q 
            a(href="#!" title="Cookies Policy").links.ms-3   Cookies Policy
            a(href="#!" title="Legal Terms").links.ms-3   Legal Terms 
            a(href="#!" title="Privacy Policy").links.ms-3.mt-lg-1.mt-xl-0  Privacy Policy
                        
                      
        

